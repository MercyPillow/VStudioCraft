    <Compile Include="VStudioCraftPackage.cs" />
    <!-- Network protocol sources. Phase 2 of the multiplayer feature lives
         here; both the standalone client and the dedicated server link
         these same files via <Link> so the wire format has exactly one
         canonical implementation. The VSIX project itself doesn't ship
         networking yet (no "Connect" UI inside Visual Studio) but compiles
         the sources so GameRenderer can reference NetClient unconditionally
         without conditional compilation. -->
    <Compile Include="Net\NetClient.cs" />
    <Compile Include="Net\NetSession.cs" />
    <Compile Include="Net\PacketIds.cs" />
    <Compile Include="Net\PacketReader.cs" />
    <Compile Include="Net\Packets.cs" />
    <Compile Include="Net\PacketWriter.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="UI\GameHostControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\alpha_terrain.png">
      <LogicalName>VStudioCraft.Assets.alpha_terrain.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="VStudioCraftPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <!-- Native OpenAL Soft binary (renamed from soft_oal.dll). Bundled with
       the VSIX so the audio engine works on hosts that don't have OpenAL
       installed system-wide (true of every clean Visual Studio install).
       AudioEngine.Initialize calls LoadLibrary on this exact path before
       touching any AL DllImport, so the runtime loader picks up our copy
       even though the extension folder isn't on the standard search path. -->
  <ItemGroup>
    <Content Include="Native\openal32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK">
      <Version>17.8.37221</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <Version>17.8.2365</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
    <PackageReference Include="OpenTK">
      <Version>3.3.3</Version>
    </PackageReference>
    <PackageReference Include="OpenTK.GLControl">
      <Version>3.1.0</Version>
    </PackageReference>
  </ItemGroup>
