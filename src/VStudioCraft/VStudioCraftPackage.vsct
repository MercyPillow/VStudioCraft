  <Commands package="guidVStudioCraftPackage">
    <Groups>
      <Group guid="guidVStudioCraftCommandSet" id="VStudioCraftMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_FILE" />
