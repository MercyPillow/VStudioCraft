        <Strings>
          <ButtonText>New Voxel World...</ButtonText>
          <CommandName>VStudioCraft.NewWorld</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVStudioCraftCommandSet" id="OpenWorldCommandId" priority="0x0101" type="Button">
        <Parent guid="guidVStudioCraftCommandSet" id="VStudioCraftMenuGroup" />
        <Strings>
          <ButtonText>Open Voxel World...</ButtonText>
          <CommandName>VStudioCraft.OpenWorld</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidVStudioCraftPackage" value="{a8d1c7e2-3f9b-4c5d-8e2a-1b6d4f7c9e3a}" />
