<Window x:Class="VStudioCraft.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VStudioCraft.UI"
        Title="VStudioCraft (standalone)"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        WindowState="Maximized">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New world"  Click="OnNew"    />
                <MenuItem Header="_Open..."    Click="OnOpen"   />
                <MenuItem Header="_Save"       Click="OnSave"   />
                <MenuItem Header="Save _as..." Click="OnSaveAs" />
                <Separator />
                <MenuItem Header="E_xit"       Click="OnExit"   />
            </MenuItem>
        </Menu>
        <ui:GameHostControl x:Name="Host" />
    </DockPanel>
</Window>
